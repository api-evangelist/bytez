          "name": "Models",
          "request": {
            "name": "Models",
            "description": {
              "content": "Retrieve a list of available models for various tasks. Use the query parameter `task` to filter by task type, e.g. `chat`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "models",
                "v2",
                "list",
